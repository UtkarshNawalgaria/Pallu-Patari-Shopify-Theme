{%- liquid
  if section.settings.collection != blank
    assign target_collection = section.settings.collection
  else
    assign target_collection = collections.all
  endif
-%}

<div class="product-collection-scroll {{ section.settings.padding_top }} {{ section.settings.padding_bottom }}">
  <div class="{{ section.settings.container_type }}">
    {%- if section.settings.heading != blank -%}
      <div class="section-title text-center mb-4">
        <h2 class="alt-font">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- paginate target_collection.products by section.settings.products_per_page -%}
      {%- if target_collection.products.size > 0 -%}
        <div
          id="main-collection-product-grid"
          data-id="{{ section.id }}"
          class="row row-cols-xxl-4 row-cols-lg-3 row-cols-2 products {{ settings.product_card_style }} product-grid"
        >
          {%- for product in target_collection.products -%}
            <div class="col product-box">
              {%- render 'product-card', product: product -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate, anchor: '', class: '' -%}
        {%- endif -%}
      {%- else -%}
        <p class="text-center">{{ 'sections.collection_template.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Infinite Collection",
  "tag": "section",
  "class": "section-product-collection-scroll",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More from this collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection",
      "info": "If not selected, all products are shown"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 40,
      "step": 4,
      "default": 16
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "default": "infinite-scroll",
      "options": [
        { "value": "infinite-scroll", "label": "Infinite scroll" },
        { "value": "load-more", "label": "Load more" }
      ]
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "w-100 overflow-hidden", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding top",
      "default": "medium-section-top",
      "options": [
        { "value": "pt-0", "label": "None" },
        { "value": "very-small-section-top", "label": "Very small" },
        { "value": "small-section-top", "label": "Small" },
        { "value": "medium-section-top", "label": "Medium" },
        { "value": "large-section-top", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": "medium-section-bottom",
      "options": [
        { "value": "pb-0", "label": "None" },
        { "value": "very-small-section-bottom", "label": "Very small" },
        { "value": "small-section-bottom", "label": "Small" },
        { "value": "medium-section-bottom", "label": "Medium" },
        { "value": "large-section-bottom", "label": "Large" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection infinite scroll"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
