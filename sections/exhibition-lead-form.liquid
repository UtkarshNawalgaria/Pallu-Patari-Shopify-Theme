{% comment %}
  ============================================================
  Exhibition Lead Capture Form — Pallu Patari

  Place this as a custom Liquid section on /pages/exhibitions.

  HOW TO ADD:
  Option A — Custom Section (Recommended):
    1. In Shopify Admin → Online Store → Themes → Edit Code
    2. Under "Sections", click "Add a new section"
    3. Name it "exhibition-lead-form"
    4. Paste this entire code
    5. Go to the Exhibitions page in the Theme Customizer
    6. Click "Add section" → choose "Exhibition Lead Form"

  Option B — Embed in page template:
    1. Create a new template (pages.exhibitions.liquid)
    2. Add {% section 'exhibition-lead-form' %} where you want it
  ============================================================
{% endcomment %}

<style>
  .pp-lead-section {
    padding: 60px 20px;
    background: var(--pp-lead-bg, #1A1A2E);
    position: relative;
    overflow: hidden;
  }

  .pp-lead-section::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .pp-lead-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .pp-lead-badge {
    display: inline-block;
    background: rgba(201, 168, 76, 0.15);
    color: #C9A84C;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid rgba(201, 168, 76, 0.3);
    margin-bottom: 20px;
  }

  .pp-lead-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .pp-lead-subtitle {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 32px 0;
    line-height: 1.6;
  }

  .pp-lead-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 440px;
    margin: 0 auto;
  }

  .pp-lead-form input[type="text"],
  .pp-lead-form input[type="tel"] {
    width: 100%;
    padding: 14px 18px;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 15px;
    color: #1A1A2E;
    background: #FFFFFF;
    border: 2px solid transparent;
    border-radius: 10px;
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .pp-lead-form input:focus {
    border-color: #C9A84C;
  }

  .pp-lead-form input::placeholder {
    color: #999;
  }

  /* Honeypot — invisible to humans */
  .pp-lead-form .pp-hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
    overflow: hidden;
    tabindex: -1;
  }

  .pp-lead-btn {
    width: 100%;
    padding: 15px 24px;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--pp-lead-btn-color, #1A1A2E);
    background: var(--pp-lead-btn-bg, #C9A84C);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0.5px;
  }

  .pp-lead-btn:hover {
    background: var(--pp-lead-btn-hover-bg, #B8963F);
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(201, 168, 76, 0.3);
  }

  .pp-lead-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* Success state */
  .pp-lead-success {
    display: none;
    text-align: center;
    animation: ppFadeIn 0.4s ease;
  }

  .pp-lead-success.active {
    display: block;
  }

  .pp-lead-form.hidden {
    display: none;
  }

  .pp-coupon-box {
    background: rgba(201, 168, 76, 0.12);
    border: 2px dashed #C9A84C;
    border-radius: 12px;
    padding: 24px;
    margin: 20px 0;
  }

  .pp-coupon-label {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 8px 0;
  }

  .pp-coupon-code {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 36px;
    font-weight: 700;
    color: #C9A84C;
    letter-spacing: 3px;
    margin: 0 0 8px 0;
  }

  .pp-coupon-discount {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .pp-qr-wrap {
    margin: 20px 0 8px;
  }

  .pp-qr-wrap img {
    width: 180px;
    height: 180px;
    border-radius: 10px;
    background: #FDF8F0;
    padding: 8px;
  }

  .pp-action-btns {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  .pp-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #C9A84C;
    background: rgba(201, 168, 76, 0.1);
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pp-copy-btn:hover {
    background: rgba(201, 168, 76, 0.2);
  }

  .pp-success-text {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
    margin: 16px 0 0 0;
    line-height: 1.5;
  }

  .pp-lead-error {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 13px;
    color: #ff6b6b;
    margin: 4px 0 0 0;
    display: none;
  }

  .pp-lead-error.active {
    display: block;
  }

  .pp-divider {
    width: 60px;
    height: 2px;
    background: #C9A84C;
    margin: 0 auto 20px;
    border-radius: 1px;
  }

  .pp-qr-note {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 16px;
    line-height: 1.5;
  }

  @keyframes ppFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .pp-lead-section {
      padding: 48px 16px;
    }
    .pp-lead-title {
      font-size: 26px;
    }
    .pp-coupon-code {
      font-size: 28px;
      letter-spacing: 2px;
    }
    .pp-qr-wrap img {
      width: 150px;
      height: 150px;
    }
  }
</style>

<section
  class="pp-lead-section"
  id="exhibition-register"
  style="
    --pp-lead-bg: {{ section.settings.background_color | default: '#1A1A2E' }};
    --pp-lead-btn-bg: {{ section.settings.button_background_color | default: '#C9A84C' }};
    --pp-lead-btn-hover-bg: {{ section.settings.button_hover_background_color | default: '#B8963F' }};
    --pp-lead-btn-color: {{ section.settings.button_text_color | default: '#1A1A2E' }};
  "
>
  <div class="pp-lead-inner">
    <span class="pp-lead-badge">{{ section.settings.badge_text }}</span>
    <h2 class="pp-lead-title">{{ section.settings.heading }}</h2>
    <div class="pp-divider"></div>
    <p class="pp-lead-subtitle">{{ section.settings.subheading }}</p>

    <!-- Lead capture form -->
    <form class="pp-lead-form" id="ppLeadForm" novalidate>
      <input
        type="text"
        name="name"
        id="ppName"
        placeholder="Your Name"
        required
        autocomplete="name"
      />
      <input
        type="tel"
        name="phone"
        id="ppPhone"
        placeholder="Phone Number (e.g. 98765 43210)"
        required
        autocomplete="tel"
        maxlength="15"
      />
      <!-- Honeypot — invisible to humans, bots auto-fill it -->
      <input
        type="text"
        name="_hp_email"
        id="ppHpEmail"
        class="pp-hp"
        tabindex="-1"
        autocomplete="off"
      />
      <button type="submit" class="pp-lead-btn" id="ppSubmitBtn">
        {{ section.settings.button_text }}
      </button>
      <p class="pp-lead-error" id="ppError"></p>
    </form>

    <!-- Success state (hidden by default) -->
    <div class="pp-lead-success" id="ppSuccess">
      <p style="font-size: 28px; margin: 0 0 8px;">🎉</p>
      <h3 style="font-family: 'Playfair Display', serif; font-size: 24px; color: #fff; margin: 0 0 4px;">
        You're registered!
      </h3>

      <!-- QR Code -->
      <div class="pp-qr-wrap">
        <img id="ppQrCode" src="" alt="Coupon QR Code" />
      </div>

      <div class="pp-coupon-box">
        <p class="pp-coupon-label">Your Exclusive Coupon</p>
        <p class="pp-coupon-code" id="ppCouponCode">—</p>
        <p class="pp-coupon-discount" id="ppCouponDiscount"></p>
      </div>

      <!-- Action buttons -->
      <div class="pp-action-btns">
        <button class="pp-copy-btn" id="ppCopyBtn" onclick="ppCopyCoupon()">
          📋 Copy Code
        </button>
        <button class="pp-copy-btn" id="ppDownloadBtn" onclick="ppDownloadQR()">
          📥 Save QR Code
        </button>
      </div>

      <p class="pp-success-text" id="ppExhibitionInfo"></p>
      <p class="pp-qr-note">
        Show this QR code at the exhibition counter to avail your discount.<br/>
        This coupon is single-use and will be marked as used once scanned.
      </p>
    </div>
  </div>
</section>

<script>
(function() {
  var WEBHOOK_URL = '{{ section.settings.webhook_url }}';
  var form = document.getElementById('ppLeadForm');
  var submitBtn = document.getElementById('ppSubmitBtn');
  var errorEl = document.getElementById('ppError');
  var successEl = document.getElementById('ppSuccess');

  // Grab UTM params from the current page URL
  function getUTMParams() {
    var params = new URLSearchParams(window.location.search);
    return {
      utmSource: params.get('utm_source') || '',
      utmMedium: params.get('utm_medium') || '',
      utmCampaign: params.get('utm_campaign') || ''
    };
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.add('active');
  }

  function clearError() {
    errorEl.textContent = '';
    errorEl.classList.remove('active');
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    clearError();

    var name = document.getElementById('ppName').value.trim();
    var phone = document.getElementById('ppPhone').value.trim().replace(/[\s\-\(\)]/g, '');
    var honeypot = document.getElementById('ppHpEmail').value;

    // Client-side validation
    if (!name || name.length < 2) {
      showError('Please enter your name.');
      return;
    }

    // Basic Indian phone check
    var cleanPhone = phone.replace(/^\+91/, '');
    if (!/^[6-9]\d{9}$/.test(cleanPhone)) {
      showError('Please enter a valid 10-digit phone number.');
      return;
    }

    // Disable button
    submitBtn.disabled = true;
    submitBtn.textContent = 'Registering...';

    var utm = getUTMParams();

    fetch(WEBHOOK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: name,
        phone: phone,
        utmSource: utm.utmSource || 'shopify',
        utmMedium: utm.utmMedium || 'website',
        utmCampaign: utm.utmCampaign || 'exhibitions-page',
        _hp_email: honeypot
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.success) {
        // Show coupon code + discount
        document.getElementById('ppCouponCode').textContent = data.couponCode;
        document.getElementById('ppCouponDiscount').textContent =
          data.discount + '% OFF at the exhibition';

        // Show QR code
        if (data.qrUrl) {
          document.getElementById('ppQrCode').src = data.qrUrl;
        }

        // Store for download
        window._ppQrUrl = data.qrUrl;
        window._ppCouponCode = data.couponCode;

        var exInfo = data.exhibition;
        if (exInfo && exInfo.name) {
          var startDate = new Date(exInfo.startDate);
          var options = { day: 'numeric', month: 'short', year: 'numeric' };
          document.getElementById('ppExhibitionInfo').textContent =
            'Show this QR at ' + exInfo.name + ', ' + exInfo.venue +
            ', ' + exInfo.city + ' • ' + startDate.toLocaleDateString('en-IN', options);
        }

        if (data.existing) {
          document.querySelector('#ppSuccess h3').textContent = 'Welcome back!';
        }

        // Switch views
        form.classList.add('hidden');
        successEl.classList.add('active');
      } else {
        showError(data.error || 'Something went wrong. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = '{{ section.settings.button_text }}';
      }
    })
    .catch(function() {
      showError('Network error. Please check your connection and try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = '{{ section.settings.button_text }}';
    });
  });
})();

function ppCopyCoupon() {
  var code = document.getElementById('ppCouponCode').textContent;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(code).then(function() {
      var btn = document.getElementById('ppCopyBtn');
      btn.textContent = '✅ Copied!';
      setTimeout(function() { btn.innerHTML = '📋 Copy Code'; }, 2000);
    });
  }
}

function ppDownloadQR() {
  var qrUrl = window._ppQrUrl;
  var couponCode = window._ppCouponCode || 'coupon';
  if (!qrUrl) return;

  fetch(qrUrl)
    .then(function(res) { return res.blob(); })
    .then(function(blob) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = couponCode + '-qr.png';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      var btn = document.getElementById('ppDownloadBtn');
      btn.textContent = '✅ Saved!';
      setTimeout(function() { btn.innerHTML = '📥 Save QR Code'; }, 2000);
    })
    .catch(function() {
      window.open(qrUrl, '_blank');
    });
}
</script>

{% schema %}
{
  "name": "Exhibition Lead Form",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "✨ Exclusive Offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Your Exhibition Discount"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Register now and receive an exclusive coupon code for discounts on our handpicked saree collection at the exhibition."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1A1A2E"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get My Coupon Code →"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#C9A84C"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Button hover background color",
      "default": "#B8963F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#1A1A2E"
    },
    {
      "type": "text",
      "id": "webhook_url",
      "label": "Webhook URL",
      "default": "https://exhibition.pallupatari.com/api/webhook/leads"
    }
  ],
  "presets": [
    {
      "name": "Exhibition Lead Form",
      "category": "Custom"
    }
  ]
}
{% endschema %}
