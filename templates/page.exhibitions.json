\n        <div class=\"pp-tags\">\n          <span>Pune</span>\n          <span>Wedding Edit</span>\n          <span>Occasion Wear</span>\n        </div>\n      </div>\n\n      <div class=\"pp-event-buttons\">\n        <a href=\"#\" class=\"pp-btn pp-btn-fill\">View Details</a>\n        <a href=\"#\" class=\"pp-btn pp-btn-outline\">WhatsApp</a>\n      </div>\n    </div>\n<div class=\"pp-event-card\">\n  <div class=\"pp-date-box\">\n    <span>Oct-Nov</span>\n    <strong>30, 31, 1</strong>\n  </div>\n\n  <div class=\"pp-event-content\">\n    <h3>Kalagram Diwali</h3>\n    <p>Siddhi Banquets, Pune · 11 AM to 8 PM · Banarasi sarees, festive drapes, occasion wear collections, and new arrivals.</p>\n\n    <div class=\"pp-tags\">\n      <span>Mumbai</span>\n      <span>Festive Edit</span>\n      <span>New Collection</span>\n    </div>\n  </div>\n\n  <div class=\"pp-event-buttons\">\n    <a href=\"#\" class=\"pp-btn pp-btn-fill\">View Details</a>\n    <a href=\"#\" class=\"pp-btn pp-btn-outline\">WhatsApp</a>\n  </div>\n</div>\n  </div>\n</section>\n\n<style>\n.pp-upcoming-section {\n  padding: 20px 0px;\n}\n\n.pp-upcoming-header {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 40px;\n  align-items: start;\n  margin-bottom: 34px;\n}\n\n.pp-upcoming-header h2 {\n  margin: 0;\n  font-size: 40px;\n  font: poppins;\n  line-height: 1.1;\n  color: #241914;\n  font-weight: 500;\n}\n\n.pp-upcoming-header p {\n  margin: 0;\n  font-size: 20px;\n  line-height: 1.6;\n  color: #75645c;\n}\n\n.pp-event-list {\n  display: flex;\n  flex-direction: column;\n  gap: 22px;\n}\n\n.pp-event-card {\n  background: #ffffff;\n  border: 1px solid #e5cdb7;\n  border-radius: 10px;\n  padding: 36px 32px;\n  display: grid;\n  grid-template-columns: 180px 1fr 220px;\n  gap: 32px;\n  align-items: center;\n}\n\n.pp-date-box {\n  border: 1px solid #e5cdb7;\n  border-radius: 10px;\n  padding: 22px 18px;\n  text-align: center;\n  font: poppins;\n  width: 150px;\n}\n\n.pp-date-box span {\n  display: block;\n  font-size: 17px;\n  font: poppins;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n  font-weight: 400;\n  margin-bottom: 10px;\n}\n\n.pp-date-box strong {\n  display: block;\n  font-size: 30px;\n  font: poppins;\n  line-height: 1;\n  color: #B33F16;\n  font-weight: 700;\n}\n\n.pp-event-content h3 {\n  margin: 0 0 10px;\n  font-size: 26px;\n  font: poppins;\n  line-height: 1.2;\n  font-weight: 500;\n}\n\n.pp-event-content p {\n  margin: 0;\n  font-size: 16px;\n  font: poppins;\n  line-height: 1.5;\n}\n\n.pp-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 18px;\n}\n\n.pp-tags span {\n  border: 1px solid #e5cdb7;\n  border-radius: 999px;    color: #B33F16;\n  padding: 2px 15px;\n  font-size: 14px;\n  font: poppins;\n  font-weight: 600;\n}\n\n.pp-event-buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.pp-btn {\n  display: block;\n  text-align: center;\n  padding: 5px 22px;\n  border-radius: 10px;\n  color: #B33F16;\n  font-size: 16px;\n  font: poppins;\n  font-weight: 500;\n  text-decoration: none;\n}\n\n.pp-btn-fill {\n  background: #b23f16;\n  color: #ffffff;\n  border: 1px solid #b23f16;\n}\n\n.pp-btn-outline {\n  background: transparent;\n  color: #B33F16;\n  border: 1px solid #b23f16;\n}\n\n@media screen and (max-width: 990px) {\n  .pp-upcoming-header {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n\n  .pp-event-card {\n    grid-template-columns: 1fr;\n    gap: 22px;\n  }\n\n  .pp-date-box {\n    width: 100%;\n    max-width: 180px;\n  }\n\n  .pp-event-buttons {\n    flex-direction: row;\n  }\n}\n\n@media screen and (max-width: 749px) {\n  .pp-upcoming-section {\n    padding: 42px 18px;\n  }\n\n  .pp-upcoming-header h2 {\n    font-size: 34px;\n  }\n\n  .pp-upcoming-header p {\n    font-size: 16px;\n  }\n\n  .pp-event-card {\n    padding: 24px;\n    border-radius: 22px;\n  }\n\n  .pp-event-content h3 {\n    font-size: 24px;\n  }\n\n  .pp-event-content p {\n    font-size: 16px;\n  }\n\n 