<section
  id="{{ section.settings.section_id }}"
  class="section-bg section-{{ section.id }} watch-and-buy {% if section.settings.section_show == false %}d-none{% endif %} {{ section.settings.section_class_name }} {{ section.settings.padding_top }} {{ section.settings.padding_bottom }} d-md-block"
  style="--section_bg: {% if section.settings.section_gradient != blank %}{{ section.settings.section_gradient }}{% else %}{{ section.settings.section_bg_color }}{% endif %}"
  data-watch-and-buy
>
  <div class="{{ section.settings.container_type }}">
    {%- if section.settings.heading != blank or section.settings.sub_heading != blank -%}
      <div class="section-info text-{{ section.settings.heading_alignment }}">
        {%- if section.settings.sub_heading != blank -%}
          <div class="section-sub-heading">{{ section.settings.sub_heading }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h3 class="section-heading alt-font">{{ section.settings.heading }}</h3>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="wab-reels-wrapper">
      <div class="wab-reels swiper" data-wab-swiper>
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'reel' -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="wab-reel" data-wab-reel data-block-id="{{ block.id }}">
                  <div class="wab-reel__media">
                    {%- if block.settings.video != blank -%}
                      {%- if block.settings.thumbnail != blank -%}
                        {%- assign video_poster = block.settings.thumbnail | image_url: width: 400 -%}
                        {%- capture reel_video -%}
                          {{
                            block.settings.video
                            | video_tag:
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              preload: 'metadata',
                              poster: video_poster,
                              image_size: '400x',
                              class: 'wab-reel__video'
                          }}
                        {%- endcapture -%}
                      {%- else -%}
                        {%- capture reel_video -%}
                          {{
                            block.settings.video
                            | video_tag:
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              preload: 'metadata',
                              image_size: '400x',
                              class: 'wab-reel__video'
                          }}
                        {%- endcapture -%}
                      {%- endif -%}
                      {{ reel_video | replace: '<video ', '<video data-wab-video ' }}
                    {%- elsif block.settings.thumbnail != blank -%}
                      <img
                        src="{{ block.settings.thumbnail | image_url: width: 400 }}"
                        alt="{{ block.settings.reel_label | default: 'Reel thumbnail' }}"
                        width="400"
                        height="710"
                        loading="lazy"
                      >
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}

                  </div>

                  {%- if block.settings.reel_label != blank -%}
                    <div class="wab-reel__label">{{ block.settings.reel_label }}</div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_navigation -%}
        <div class="wab-nav-prev"><i class="feather-chevron-left"></i></div>
        <div class="wab-nav-next"><i class="feather-chevron-right"></i></div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Modal overlay for reel playback + products {%- endcomment -%}
  <div class="wab-modal" data-wab-modal aria-hidden="true" role="dialog" aria-label="Watch and buy">
    <div class="wab-modal__backdrop" data-wab-modal-close></div>
    <div class="wab-modal__container">
      <button type="button" class="wab-modal__close" data-wab-modal-close aria-label="Close">
        <i class="feather-x"></i>
      </button>

      <video
        class="wab-modal__video"
        loop
        playsinline
        preload="metadata"
        data-wab-modal-video
      ></video>

      <div class="wab-modal__overlay">
        <div class="wab-modal__overlay-controls">
          <button type="button" class="wab-modal__mute-btn" data-wab-mute aria-label="Toggle sound">
            <svg class="wab-icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <svg class="wab-icon-unmuted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          </button>
        </div>

        <div class="wab-modal__products-drawer" data-wab-products-drawer>
          <div class="wab-modal__drawer-handle-zone" data-wab-drag-handle>
            <div class="wab-modal__drawer-handle"></div>
          </div>
          <div class="wab-modal__products-header">Shop this look</div>
          <div class="wab-modal__products-list" data-wab-products-list></div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Hidden product data for each reel block {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'reel' -%}
      <template data-wab-product-data="{{ block.id }}">
        {%- liquid
          assign products_in_reel = ''
          assign product_count = 0

          if block.settings.product_1 != blank
            assign product_count = product_count | plus: 1
          endif
          if block.settings.product_2 != blank
            assign product_count = product_count | plus: 1
          endif
          if block.settings.product_3 != blank
            assign product_count = product_count | plus: 1
          endif
          if block.settings.product_4 != blank
            assign product_count = product_count | plus: 1
          endif
          if block.settings.product_5 != blank
            assign product_count = product_count | plus: 1
          endif
        -%}

        <div data-product-count="{{ product_count }}">
          {%- if block.settings.product_1 != blank -%}
            {%- assign p = block.settings.product_1 -%}
            <div class="wab-product-card {% if product_count == 1 %}wab-product-card--single{% endif %}">
              <a href="{{ p.url }}" class="wab-product-card__image">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="300" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="wab-product-card__info">
                <a href="{{ p.url }}" class="wab-product-card__title">{{ p.title }}</a>
                <div class="wab-product-card__price">
                  {%- if p.compare_at_price > p.price -%}
                    <span class="wab-price--sale">{{ p.price | money }}</span>
                    <span class="wab-price--compare">{{ p.compare_at_price | money }}</span>
                  {%- else -%}
                    <span>{{ p.price | money }}</span>
                  {%- endif -%}
                </div>
                {%- if product_count == 1 -%}
                  <a href="{{ p.url }}" class="wab-product-card__btn">View Product</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.product_2 != blank -%}
            {%- assign p = block.settings.product_2 -%}
            <div class="wab-product-card">
              <a href="{{ p.url }}" class="wab-product-card__image">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="300" loading="lazy">
                {%- else -%}
                  {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="wab-product-card__info">
                <a href="{{ p.url }}" class="wab-product-card__title">{{ p.title }}</a>
                <div class="wab-product-card__price">
                  {%- if p.compare_at_price > p.price -%}
                    <span class="wab-price--sale">{{ p.price | money }}</span>
                    <span class="wab-price--compare">{{ p.compare_at_price | money }}</span>
                  {%- else -%}
                    <span>{{ p.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.product_3 != blank -%}
            {%- assign p = block.settings.product_3 -%}
            <div class="wab-product-card">
              <a href="{{ p.url }}" class="wab-product-card__image">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="300" loading="lazy">
                {%- else -%}
                  {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="wab-product-card__info">
                <a href="{{ p.url }}" class="wab-product-card__title">{{ p.title }}</a>
                <div class="wab-product-card__price">
                  {%- if p.compare_at_price > p.price -%}
                    <span class="wab-price--sale">{{ p.price | money }}</span>
                    <span class="wab-price--compare">{{ p.compare_at_price | money }}</span>
                  {%- else -%}
                    <span>{{ p.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.product_4 != blank -%}
            {%- assign p = block.settings.product_4 -%}
            <div class="wab-product-card">
              <a href="{{ p.url }}" class="wab-product-card__image">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="300" loading="lazy">
                {%- else -%}
                  {{ 'product-4' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="wab-product-card__info">
                <a href="{{ p.url }}" class="wab-product-card__title">{{ p.title }}</a>
                <div class="wab-product-card__price">
                  {%- if p.compare_at_price > p.price -%}
                    <span class="wab-price--sale">{{ p.price | money }}</span>
                    <span class="wab-price--compare">{{ p.compare_at_price | money }}</span>
                  {%- else -%}
                    <span>{{ p.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.product_5 != blank -%}
            {%- assign p = block.settings.product_5 -%}
            <div class="wab-product-card">
              <a href="{{ p.url }}" class="wab-product-card__image">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="300" loading="lazy">
                {%- else -%}
                  {{ 'product-5' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="wab-product-card__info">
                <a href="{{ p.url }}" class="wab-product-card__title">{{ p.title }}</a>
                <div class="wab-product-card__price">
                  {%- if p.compare_at_price > p.price -%}
                    <span class="wab-price--sale">{{ p.price | money }}</span>
                    <span class="wab-price--compare">{{ p.compare_at_price | money }}</span>
                  {%- else -%}
                    <span>{{ p.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </template>

      {%- comment -%} Store video source for modal {%- endcomment -%}
      <script type="application/json" data-wab-video-src="{{ block.id }}">
        {%- if block.settings.video != blank -%}
          {%- assign modal_video_src = '' -%}
          {%- for source in block.settings.video.sources -%}
            {%- if source.mime_type == 'video/mp4' -%}
              {%- assign modal_video_src = source.url -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if modal_video_src == '' and block.settings.video.sources.size > 0 -%}
            {%- assign modal_video_src = block.settings.video.sources[0].url -%}
          {%- endif -%}
          { "type": "hosted", "src": {{ modal_video_src | json }}, "poster": {% if block.settings.thumbnail != blank %}{{ block.settings.thumbnail | image_url: width: 800 | json }}{% else %}""{% endif %} }
        {%- else -%}
          { "type": "none", "src": "", "poster": "" }
        {%- endif -%}
      </script>
    {%- endif -%}
  {%- endfor -%}
</section>

<style>
  .section-{{ section.id }} .section-info {
    margin-bottom: 30px;
  }

  {%- unless section.settings.use_default_section_typography -%}
    .section-{{ section.id }} .section-heading {
      font-size: {{ section.settings.section_heading_size }}px;
      line-height: {{ section.settings.heading_line_height }}px;
    }
    .section-{{ section.id }} .section-sub-heading {
      font-size: {{ section.settings.sub_heading_size }}px;
      letter-spacing: {{ section.settings.subheading_letter_spacing }}px;
      line-height: {{ section.settings.sub_heading_line_height }}px;
    }
  {%- endunless -%}

  {%- if section.settings.section_heading_color != blank -%}
    .section-{{ section.id }} .section-heading {
      color: {{ section.settings.section_heading_color }};
    }
  {%- endif -%}
  {%- if section.settings.section_sub_heading_color != blank -%}
    .section-{{ section.id }} .section-sub-heading {
      color: {{ section.settings.section_sub_heading_color }};
    }
  {%- endif -%}

  .wab-reels-wrapper {
    position: relative;
    overflow: hidden;
  }

  /*
   * Reel grid — works with or without Swiper.
   * Gap is handled via padding on each slide to avoid calc rounding issues.
   */
  .section-{{ section.id }} .wab-reels {
    overflow: visible;
    margin: 0 -10px;
  }
  .section-{{ section.id }} .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
  }
  .section-{{ section.id }} .swiper-slide {
    flex: 0 0 auto;
    width: calc(100% / {{ section.settings.desktop_reels_per_view }});
    padding: 0 10px;
    box-sizing: border-box;
  }
  @media (max-width: 991px) {
    .section-{{ section.id }} .swiper-slide {
      width: calc(100% / {{ section.settings.tablet_reels_per_view }});
    }
  }
  @media (max-width: 575px) {
    .section-{{ section.id }} .swiper-slide {
      width: calc(100% / {{ section.settings.mobile_reels_per_view }});
      padding: 0 6px;
    }
  }

  .wab-reel {
    cursor: pointer;
    text-align: center;
  }

  .wab-reel__media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: {{ section.settings.reel_border_radius }}px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .wab-reel__media video,
  .wab-reel__media img,
  .wab-reel__media .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wab-reel__label {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--heading-color, #333);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wab-nav-prev,
  .wab-nav-next {
    position: absolute;
    top: calc(50% - 20px);
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: box-shadow 0.2s;
    font-size: 18px;
  }
  .wab-nav-prev:hover,
  .wab-nav-next:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .wab-nav-prev { left: -20px; }
  .wab-nav-next { right: -20px; }

  @media (max-width: 767px) {
    .wab-nav-prev { left: 4px; }
    .wab-nav-next { right: 4px; }
  }

  /* ── Modal — fullscreen video with product drawer overlay ── */
  .wab-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .wab-modal.is-active {
    opacity: 1;
    visibility: visible;
  }

  .wab-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }

  .wab-modal__container {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 480px;
    margin: 0 auto;
    overflow: hidden;
  }

  /* Video fills the container */
  .wab-modal__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Overlay sits on top of video */
  .wab-modal__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .wab-modal__overlay > * {
    pointer-events: auto;
  }

  .wab-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 5;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    pointer-events: auto;
  }
  .wab-modal__close:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .wab-modal__overlay-controls {
    position: absolute;
    bottom: 16px;
    right: 16px;
    z-index: 4;
  }

  .wab-modal__mute-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .wab-modal__mute-btn:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  /* ── Product drawer — anchored to bottom, draggable via --wab-drawer-h ── */
  .wab-modal__products-drawer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--wab-drawer-h, 35%);
    max-height: 70%;
    overflow-y: auto;
    background: rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-radius: 16px 16px 0 0;
    padding: 0 16px 20px;
    z-index: 3;
    transition: height 0.3s ease;
    will-change: height;
    overscroll-behavior: contain;
  }
  .wab-modal__products-drawer.is-dragging {
    transition: none;
  }

  .wab-modal__drawer-handle-zone {
    padding: 10px 0 8px;
    cursor: grab;
    touch-action: none;
    display: flex;
    justify-content: center;
    position: sticky;
    top: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.55);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-radius: 16px 16px 0 0;
    margin: 0 -16px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .wab-modal__drawer-handle {
    width: 36px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.4);
  }

  .wab-modal__products-header {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 12px;
    color: #fff;
  }

  .wab-modal__products-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ── Product cards — glass style ── */
  .wab-product-card {
    display: flex;
    gap: 12px;
    padding: 10px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    transition: background 0.2s;
    text-decoration: none;
  }
  .wab-product-card:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .wab-product-card__image {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }
  .wab-product-card__image img,
  .wab-product-card__image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wab-product-card__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .wab-product-card__title {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .wab-product-card__title:hover {
    text-decoration: underline;
    color: #fff;
  }

  .wab-product-card__price {
    font-size: 13px;
    display: flex;
    gap: 8px;
    align-items: center;
    color: #fff;
  }
  .wab-price--sale {
    color: #ff6b6b;
    font-weight: 600;
  }
  .wab-price--compare {
    text-decoration: line-through;
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
  }

  /* Single product card — centered layout */
  .wab-product-card--single {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px;
  }
  .wab-product-card--single .wab-product-card__image {
    width: 120px;
    height: 120px;
    border-radius: 10px;
  }
  .wab-product-card--single .wab-product-card__info {
    align-items: center;
  }
  .wab-product-card--single .wab-product-card__title {
    font-size: 15px;
  }
  .wab-product-card--single .wab-product-card__price {
    font-size: 15px;
    margin-bottom: 10px;
  }

  .wab-product-card__btn {
    display: inline-block;
    padding: 10px 28px;
    background: #fff;
    color: #222;
    text-decoration: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .wab-product-card__btn:hover {
    background: rgba(255, 255, 255, 0.85);
    color: #222;
  }

  /* ── Desktop: side-by-side layout ── */
  @media (min-width: 768px) {
    .wab-modal__container {
      max-width: 900px;
      display: flex;
      max-height: 85vh;
      border-radius: 12px;
      top: 50%;
      transform: translateY(-50%);
    }
    .wab-modal__video {
      position: relative;
      width: 400px;
      flex-shrink: 0;
      border-radius: 12px 0 0 12px;
    }
    .wab-modal__overlay {
      position: relative;
      flex: 1;
      background: rgba(0, 0, 0, 0.65);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
      border-radius: 0 12px 12px 0;
    }
    .wab-modal__products-drawer {
      position: relative;
      height: auto !important;
      max-height: 100%;
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-radius: 0;
      padding: 24px;
    }
    .wab-modal__drawer-handle-zone {
      display: none;
    }
    .wab-modal__overlay-controls {
      position: absolute;
      bottom: 16px;
      left: -52px;
      right: auto;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('.section-{{ section.id }}[data-watch-and-buy]');
    if (!section) return;

    /* ── Swiper init with retry (waits for Swiper JS to load) ── */
    var swiperEl = section.querySelector('[data-wab-swiper]');
    var swiperInstance = null;

    function initSwiper() {
      if (!swiperEl || swiperInstance) return;
      if (typeof Swiper === 'undefined') return false;
      swiperInstance = new Swiper(swiperEl, {
        slidesPerView: {{ section.settings.mobile_reels_per_view }},
        spaceBetween: 0,
        navigation: {
          prevEl: section.querySelector('.wab-nav-prev'),
          nextEl: section.querySelector('.wab-nav-next')
        },
        breakpoints: {
          576: { slidesPerView: {{ section.settings.tablet_reels_per_view }}, spaceBetween: 0 },
          992: { slidesPerView: {{ section.settings.desktop_reels_per_view }}, spaceBetween: 0 }
        }
      });
      return true;
    }

    if (!initSwiper()) {
      /* Swiper JS not yet loaded — retry on DOMContentLoaded then poll briefly */
      document.addEventListener('DOMContentLoaded', function() {
        if (!initSwiper()) {
          var tries = 0;
          var poll = setInterval(function() {
            if (initSwiper() || ++tries > 20) clearInterval(poll);
          }, 200);
        }
      });
    }

    /* ── Autoplay all reel videos muted + infinite loop ── */
    function autoplayReelVideos() {
      section.querySelectorAll('[data-wab-video]').forEach(function(vid) {
        vid.muted = true;
        vid.play().catch(function(){});
      });
    }
    autoplayReelVideos();
    document.addEventListener('DOMContentLoaded', autoplayReelVideos);

    /* ── Modal logic ── */
    var modal = section.querySelector('[data-wab-modal]');
    var modalVideo = modal.querySelector('[data-wab-modal-video]');
    var productsList = modal.querySelector('[data-wab-products-list]');
    var muteBtn = modal.querySelector('[data-wab-mute]');
    var isMuted = true;

    function openModal(blockId) {
      var srcData = section.querySelector('[data-wab-video-src="' + blockId + '"]');
      var prodTemplate = section.querySelector('[data-wab-product-data="' + blockId + '"]');
      var reel = section.querySelector('[data-wab-reel][data-block-id="' + blockId + '"]');
      var reelVideo = reel ? reel.querySelector('[data-wab-video]') : null;
      if (!prodTemplate) return;

      var info = srcData ? JSON.parse(srcData.textContent) : {};
      var source = info.src || '';
      if (!source && reelVideo) {
        source = reelVideo.currentSrc || reelVideo.src || '';
        if (!source) {
          var firstSource = reelVideo.querySelector('source');
          source = firstSource ? firstSource.src : '';
        }
      }
      if (!source) return;

      modalVideo.src = source;
      if (info.poster) modalVideo.poster = info.poster;
      modalVideo.muted = true;
      modalVideo.loop = true;
      isMuted = true;
      updateMuteIcon();

      productsList.innerHTML = prodTemplate.innerHTML;

      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modalVideo.play().catch(function(){});
    }

    function closeModal() {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      modalVideo.pause();
      modalVideo.removeAttribute('src');
      modalVideo.load();
      productsList.innerHTML = '';
    }

    function updateMuteIcon() {
      var mutedIcon = muteBtn.querySelector('.wab-icon-muted');
      var unmutedIcon = muteBtn.querySelector('.wab-icon-unmuted');
      mutedIcon.style.display = isMuted ? '' : 'none';
      unmutedIcon.style.display = isMuted ? 'none' : '';
    }

    section.querySelectorAll('[data-wab-reel]').forEach(function(reel) {
      reel.addEventListener('click', function() {
        openModal(reel.getAttribute('data-block-id'));
      });
    });

    modal.querySelectorAll('[data-wab-modal-close]').forEach(function(el) {
      el.addEventListener('click', closeModal);
    });

    muteBtn.addEventListener('click', function() {
      isMuted = !isMuted;
      modalVideo.muted = isMuted;
      updateMuteIcon();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) closeModal();
    });

    /* ── Drawer drag-to-resize (touch + mouse) ── */
    var drawer = modal.querySelector('[data-wab-products-drawer]');
    var dragHandle = modal.querySelector('[data-wab-drag-handle]');
    if (drawer && dragHandle) {
      var dragging = false;
      var startY = 0;
      var startH = 0;
      var containerH = 0;
      /* Snap points as % of container height */
      var SNAP_MIN  = 10;  /* minimised — just the handle visible */
      var SNAP_MID  = 35;  /* default — shows a couple of products */
      var SNAP_MAX  = 70;  /* expanded — half+ of screen */

      function pxToPct(px) { return (px / containerH) * 100; }

      function snapTo(pct) {
        var dists = [
          { p: SNAP_MIN, d: Math.abs(pct - SNAP_MIN) },
          { p: SNAP_MID, d: Math.abs(pct - SNAP_MID) },
          { p: SNAP_MAX, d: Math.abs(pct - SNAP_MAX) }
        ];
        dists.sort(function(a, b) { return a.d - b.d; });
        return dists[0].p;
      }

      function onDragStart(e) {
        e.preventDefault();
        dragging = true;
        startY = (e.touches ? e.touches[0].clientY : e.clientY);
        containerH = drawer.parentElement.closest('.wab-modal__container').offsetHeight;
        startH = drawer.offsetHeight;
        drawer.classList.add('is-dragging');
      }

      function onDragMove(e) {
        if (!dragging) return;
        var clientY = (e.touches ? e.touches[0].clientY : e.clientY);
        var delta = startY - clientY; /* positive = drag up = taller */
        var newH = startH + delta;
        var pct = pxToPct(newH);
        pct = Math.max(SNAP_MIN, Math.min(SNAP_MAX, pct));
        drawer.style.setProperty('--wab-drawer-h', pct + '%');
      }

      function onDragEnd() {
        if (!dragging) return;
        dragging = false;
        drawer.classList.remove('is-dragging');
        /* Snap to nearest point */
        var currentPct = pxToPct(drawer.offsetHeight);
        var snapped = snapTo(currentPct);
        drawer.style.setProperty('--wab-drawer-h', snapped + '%');
      }

      /* Touch events on handle */
      dragHandle.addEventListener('touchstart', onDragStart, { passive: false });
      document.addEventListener('touchmove', onDragMove, { passive: false });
      document.addEventListener('touchend', onDragEnd);

      /* Mouse events for desktop testing */
      dragHandle.addEventListener('mousedown', onDragStart);
      document.addEventListener('mousemove', onDragMove);
      document.addEventListener('mouseup', onDragEnd);

      /* Reset drawer height when modal closes */
      var origClose = closeModal;
      closeModal = function() {
        drawer.style.setProperty('--wab-drawer-h', SNAP_MID + '%');
        origClose();
      };
    }
  })();
</script>

